    "name": "Flask user app",
    "description": "Lab 5 (Postman and APIs), Maya Zeaiter.\n\nCRUD requests for the Flask + SQLite user management API. The server URL is stored in the environment variable `base_url` (environment: \"Flask user app - local\").\n\nRun order: Add user first. Its test script saves the new id to the environment variable `user_id`, which Get user by ID, Update user and Delete user then use.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Add user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/users/add",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users",
            "add"
          ]
        },
        "description": "Create a new user record. Calls insert_user() and returns the inserted user, including its auto generated user_id.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"John Doe\",\n    \"email\": \"jondoe@gamil.com\",\n    \"phone\": \"067765434567\",\n    \"address\": \"John Doe Street, Innsbruck\",\n    \"country\": \"Austria\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [
        {
          "name": "Add user - 200 OK",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/add",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "add"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"John Doe\",\n    \"email\": \"jondoe@gamil.com\",\n    \"phone\": \"067765434567\",\n    \"address\": \"John Doe Street, Innsbruck\",\n    \"country\": \"Austria\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Server",
              "value": "Werkzeug/3.1.7 Python/3.12.3"
            },
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Content-Length",
              "value": "141"
            },
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "key": "Connection",
              "value": "close"
            }
          ],
          "cookie": [],
          "body": "{\n    \"address\": \"John Doe Street, Innsbruck\",\n    \"country\": \"Austria\",\n    \"email\": \"jondoe@gamil.com\",\n    \"name\": \"John Doe\",\n    \"phone\": \"067765434567\",\n    \"user_id\": 1\n}"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test(\"New user has a numeric user_id\", function () {",
              "    pm.expect(body.user_id).to.be.a(\"number\");",
              "});",
              "// save the new id so the next requests can use {{user_id}}",
              "pm.environment.set(\"user_id\", body.user_id);"
            ]
          }
        }
      ]
    },
